# Pooled Neon connection used by the application runtime.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/fabrica?sslmode=require

# Direct Neon connection used only by Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/fabrica?sslmode=require

# Branch metadata written by `neon env pull`.
NEON_BRANCH=main

# Google OAuth web credentials. The redirect URI must end in
# /api/auth/google/callback and exactly match the Google Cloud configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Mercado Pago server credentials. Keep values empty in version control.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_PLAN_INICIAL=
MERCADOPAGO_PLAN_ESTUDIO=
MERCADOPAGO_PLAN_EQUIPO=
APP_BASE_URL=http://localhost:3000
